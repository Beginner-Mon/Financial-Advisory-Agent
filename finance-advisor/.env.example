# Google Gemini API Key (required for agent functionality)
# Get your free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Model selection (optional, defaults shown)
GEMINI_MODEL=gemini-2.5-flash

# Database path (optional, defaults to data/db.sqlite)
# DB_PATH=data/db.sqlite

# Product catalog path (optional, defaults to data/products.json)
# CATALOG_PATH=data/products.json

# Logging level (optional, defaults to INFO)
# LOG_LEVEL=INFO

# CORS — comma-separated allowed origins
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# JWT Authentication
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
